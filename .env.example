# Local mode (works now without Docker)
SITE_DATABASE_URL=sqlite:///data/healthcare_cti.db

# Supabase mode: remove/comment SITE_DATABASE_URL, then set these values.
# Keeping the password separate supports special characters safely.
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.mcnwmszykwnanedfpfso
# SUPABASE_DB_PASSWORD=replace-with-your-database-password

# Docker Compose PostgreSQL password
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Threat-intelligence providers
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
NVD_API_KEY=

# Website login (replace every default before publishing)

# Optional pgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@hospital.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
